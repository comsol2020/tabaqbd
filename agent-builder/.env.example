# Miarouter (MAIA Router). Key from https://maiarouter.ai or https://router.maia.id
MIAROUTER_API_KEY=
MIAROUTER_BASE_URL=https://api.maiarouter.ai/v1
MIAROUTER_DEFAULT_MODEL=maia/gemini-2.5-flash

# Another Miarouter-compatible host, if your key is for that host:
# MIAROUTER_BASE_URL=https://miarouter.online/v1

# More OpenAI-compatible APIs. Keys stay in their own env vars.
# EXTRA_PROVIDERS_JSON=[{"id":"openrouter","label":"OpenRouter","protocol":"openai-compatible","baseUrl":"https://openrouter.ai/api/v1","apiKeyEnv":"OPENROUTER_API_KEY","defaultModel":"openai/gpt-4o-mini"}]
# OPENROUTER_API_KEY=
